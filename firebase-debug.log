uest.auth.token.email);\n      allow read, update, delete: if isTeacher();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-25T21:43:37.258287Z","metadata":{"services":["cloud.firestore"]}}
