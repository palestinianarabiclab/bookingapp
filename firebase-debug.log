 <= 200 &&\n        (!request.resource.data.keys().hasAny(['stack']) ||\n          request.resource.data.stack is string &&\n          request.resource.data.stack.size() <= 4000) &&\n        (!request.resource.data.keys().hasAny(['uid']) ||\n          request.resource.data.uid == request.auth.uid) &&\n        (!request.resource.data.keys().hasAny(['email']) ||\n          request.resource.data.email == request.auth.token.email);\n      allow read, update, delete: if isTeacher();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-25T22:08:12.721167Z","metadata":{"services":["cloud.firestore"]}}
